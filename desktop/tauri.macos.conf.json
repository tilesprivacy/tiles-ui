{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeDevCommand": "npm run dev & npm run dev:panel",
		"beforeBuildCommand": "npm run build && npm run build:panel"
	},
	"app": {
		"windows": [
			{
				"label": "panel",
				"url": "panel/index.html",
				"width": 380,
				"height": 170,
				"decorations": false,
				"resizable": false,
				"skipTaskbar": true,
				"visible": false,
				"shadow": true,
				"focus": false,
				"acceptFirstMouse": true,
				"center": false
			}
		]
	}
}
