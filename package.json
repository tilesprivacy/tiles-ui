{
	"name": "tiles-ui",
	"private": true,
	"version": "2.0.0-dev",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/boot-file.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
